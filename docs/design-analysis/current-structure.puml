@startuml
!pragma layout smetana
title Klassen der Tagesübersicht (Ist, Ausschnitt) – betroffene Stellen bei Änderung "Gewohnheit pausieren"
skinparam classAttributeIconSize 0
hide empty members

package "presentation" {
  class HomeView <<Vue-Komponente>> #FFE5E5 {
    - todayHabits: Habit[]
    - visibleHabits: Habit[]
  }

  class habitStore <<Pinia-Store>> {
    + habits: Habit[]
    + hiddenHabitIds: Set<string>
    + loadAllHabits(): Promise<void>
  }

  class "HabitEditView /\nHabitDeleteView" as OtherViews <<Vue-Komponente>> {
  }
}

package "domain" {
  interface GetAllHabitsQuery <<Inbound Port>> {
    + execute(): Promise<Habit[]>
  }

  class GetAllHabitsService {
    + execute(): Promise<Habit[]>
  }

  interface HabitRepositoryPort <<Outbound Port>> {
    + findAll(): Promise<Habit[]>
  }

  interface Habit #FFE5E5 {
    + id: string
    + title: string
    + periodicity?: Periodicity
    + weekdays?: Weekday[]
    <color:#C00000>+ status: 'active' | 'paused' (neu)</color>
  }
}

package "infrastructure" {
  class SupabaseHabitAdapter #FFE5E5 {
    - mapToHabit(row: HabitRow): Habit
    + findAll(): Promise<Habit[]>
  }

  class HabitRow <<type>> #FFE5E5 {
    + id: string
    + title: string
    + periodicity?: string
    + weekdays?: string[]
    <color:#C00000>+ status: string (neu)</color>
  }
}

HomeView ..> habitStore : nutzt
OtherViews ..> habitStore : nutzt
habitStore "1" o-- "0..*" Habit : habits
habitStore --> GetAllHabitsService : ruft auf
habitStore ..> SupabaseHabitAdapter : <<create>>

GetAllHabitsService ..|> GetAllHabitsQuery
GetAllHabitsService --> "1" HabitRepositoryPort : habitRepository

SupabaseHabitAdapter ..|> HabitRepositoryPort
SupabaseHabitAdapter ..> HabitRow : mappt

note "pausierte Habits ausblenden:\nA1 (kurzfristig): Bedingung in todayHabits\nA2 (langfristig): Regel als Domänenfunktion,\nz. B. isScheduledForToday(habit, date)" as NoteView #FFE5E5
NoteView .. HomeView

note "Grund für 'alle Habits laden':\nHabitEditView braucht auch pausierte,\num sie wieder zu aktivieren\n(Schalter dort liegt außerhalb\ndes untersuchten Ablaufs)" as NoteOther #FFFFFF
NoteOther .. OtherViews

note "SELECT_COLS und mapToHabit\num status erweitern;\nTabelle habits: neue Spalte\nstatus + Migration" as NoteAdapter #FFE5E5
NoteAdapter .. SupabaseHabitAdapter

legend right
  |= Farbe |= Bedeutung |
  |<#FFE5E5>| betroffen |
  | Standardfarbe | nicht betroffen |
  | <color:#C00000>rot</color> | neues Attribut |
endlegend
@enduml
