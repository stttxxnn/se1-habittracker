@startuml
skinparam monochrome true
skinparam defaultFontSize 12

entity "habit" as habit {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * title : TEXT
  * streak_count : INTEGER
  * created_at : TIMESTAMP
  * scheduled_time : TIME
  * duration_minutes : INTEGER
  * color : TEXT
  * periodicity : TEXT
  * weekdays : TEXT[]
  * icon : TEXT
  * reason : TEXT
}

entity "habit_completions" as execution {
  * id : UUID <<PK>>
  --
  * habit_id : UUID <<FK>>
  * user_id : UUID <<FK>>
  * created_at : TIMESTAMP
  * completed_date : DATE
  * is_completed : BOOL
}

habit ||--o{ execution : "besitzt"

@enduml